generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(uuid())
  memberId   String   @unique
  name       String
  role       String   @default("MEMBER") // ADMIN, STAFF, MEMBER
  email      String?  @unique
  password   String
  phone      String?
  nic        String?
  occupation String?
  address    String?
  // For STAFF permissions
  permCirculation Boolean  @default(false)
  permCatalog     Boolean  @default(false)
  permMembers     Boolean  @default(false)
  permInventory   Boolean  @default(false)
  permDashboard   Boolean  @default(false)

  createdAt     DateTime @default(now())
  
  loans         Loan[]
  reservations  Reservation[]
  reviews       Review[]
}

model Book {
  id            String   @id @default(uuid())
  accNo         String   @unique
  accNoInt      Int?
  dateAdded     String?
  title         String
  author        String?
  publisher     String?
  year          String?
  vendor        String?
  price         Float?
  billNo        String?
  isbn          String?
  ddc           String?
  itemType      String?  @default("LENDING") // LENDING, REFERENCE, MAGAZINE, MEDIA
  category      String?
  shelfLoc      String?
  
  status        String   @default("AVAILABLE") // AVAILABLE, BORROWED, LOST, DISCARDED, REPAIR
  lastVerified  DateTime?
  
  loans         Loan[]
  reservations  Reservation[]
  reviews       Review[]
}

model Loan {
  id            String   @id @default(uuid())
  bookId        String
  userId        String
  borrowDate    DateTime @default(now())
  dueDate       DateTime
  returnDate    DateTime?
  fine          Float    @default(0)
  finePaid      Boolean  @default(false)
  finePaidDate  DateTime?
  status        String   @default("ACTIVE") // ACTIVE, RETURNED
  lastReminded  DateTime?
  renewalsCount Int      @default(0)

  book       Book     @relation(fields: [bookId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Reservation {
  id         String   @id @default(uuid())
  bookId     String
  userId     String
  status     String   @default("PENDING") // PENDING, FULFILLED, CANCELLED
  createdAt  DateTime @default(now())

  book       Book     @relation(fields: [bookId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model Review {
  id         String   @id @default(uuid())
  bookId     String
  userId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  book       Book     @relation(fields: [bookId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
}

model SystemConfig {
  id                    Int     @id @default(1)
  dailyFineRate         Float   @default(5.0)
  borrowPeriodDays      Int     @default(14)
  renewalPeriodDays     Int     @default(14)
  reminderDaysBeforeDue Int     @default(1)
  smtpEmail             String?
  smtpPassword          String?
}
